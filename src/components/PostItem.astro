---
import { formatDate, readingTime, type Post } from '@/lib/content';
import TagList from './TagList.astro';

interface Props {
  post: Post;
  headingLevel?: 'h2' | 'h3';
}
const { post, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---

<article class="post-item">
  <div class="meta label">
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    <span aria-hidden="true">&middot;</span>
    <span>{readingTime(post.body)}</span>
  </div>
  <div class="body">
    <H class="title"><a href={`/blog/${post.id}/`}>{post.data.title}</a></H>
    <p>{post.data.description}</p>
    <TagList tags={post.data.tags} linked />
  </div>
</article>

<style>
  .post-item {
    display: grid;
    gap: 0.5rem 2rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--border);
    position: relative;
    transition: background 0.2s;
  }
  .post-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.75rem;
    bottom: 0;
    width: 2px;
    background: var(--accent);
    opacity: 0;
    transform: scaleY(0);
    transform-origin: top;
    transition: opacity 0.3s, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .post-item:hover::before {
    opacity: 1;
    transform: scaleY(1);
  }
  .post-item:hover {
    padding-left: 1rem;
  }
  .meta {
    display: flex;
    gap: 0.5rem;
    padding-top: 0.3rem;
    white-space: nowrap;
  }
  .title {
    font-size: 1.2rem;
    margin: 0 0 0.35rem;
  }
  .title a {
    text-decoration: none;
  }
  p {
    color: var(--muted);
    margin: 0 0 0.75rem;
  }
  @media (min-width: 48rem) {
    .post-item {
      grid-template-columns: 11rem 1fr;
      transition: background 0.2s, padding-left 0.3s;
    }
    .meta {
      flex-direction: column;
      gap: 0.15rem;
    }
    .meta [aria-hidden] {
      display: none;
    }
  }
</style>
