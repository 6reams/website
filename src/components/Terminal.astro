---
import { site } from '@config';
const prompt = `${site.terminalUser}@${site.brand}:~$`;
---

<div class="terminal" role="img" aria-label={`Terminal: whoami returns ${site.name}, ${site.role}`}>
  <div class="chrome" aria-hidden="true"><span></span><span></span><span></span></div>
  <pre aria-hidden="true"><code><span class="p">{prompt}</span> whoami
{site.name.toLowerCase().replace(/\s+/g, '_')} <span class="c"># {site.role}</span>
<span class="p">{prompt}</span> cat focus.txt
active-directory  web-apps  red-team  appsec
<span class="p">{prompt}</span> <span class="cursor"></span></code></pre>
</div>

<style>
  .terminal {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-soft);
    overflow: hidden;
    max-width: 34rem;
  }
  .chrome {
    display: flex;
    gap: 0.4rem;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--border);
  }
  .chrome span {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--border-strong);
  }
  pre {
    margin: 0;
    padding: 1rem 1.1rem 1.15rem;
    font-size: 0.8rem;
    line-height: 1.8;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: var(--fg);
  }
  .p {
    color: var(--accent);
  }
  .c {
    color: var(--muted);
  }
  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    vertical-align: -0.15em;
    background: var(--accent);
    animation: blink 1.1s steps(2, start) infinite;
  }
  @keyframes blink {
    to {
      visibility: hidden;
    }
  }
</style>
