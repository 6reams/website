---
import { site } from '@config';
import ThemeToggle from './ThemeToggle.astro';

const nav = [
  { href: '/projects/', label: 'Projects' },
  { href: '/blog/', label: 'Blog' },
  { href: '/certifications/', label: 'Certs' },
  { href: '/tools/', label: 'Tools' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label={`${site.brand} — home`}>
      <span class="brand-mark" aria-hidden="true">&gt;_</span>
      <span>{site.brand}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(160%) blur(12px);
    -webkit-backdrop-filter: saturate(160%) blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: 'brand toggle' 'nav nav';
    align-items: center;
    gap: 0.25rem 1rem;
    padding-block: 0.75rem 0.25rem;
  }
  .brand {
    grid-area: brand;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font: 700 1.05rem/1 var(--font-mono);
    letter-spacing: 0.04em;
    text-decoration: none;
    justify-self: start;
  }
  .brand-mark {
    display: inline-grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 8px;
    background: var(--accent);
    color: var(--accent-fg);
    font-size: 0.75rem;
  }
  nav {
    grid-area: nav;
    overflow-x: auto;
    scrollbar-width: none;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
  }
  nav::-webkit-scrollbar {
    display: none;
  }
  ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: inline-block;
    padding: 0.55rem 0.7rem;
    border-radius: 8px;
    font-size: 0.925rem;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }
  nav a:hover {
    color: var(--fg);
    background: var(--bg-soft);
  }
  nav a[aria-current='page'] {
    color: var(--accent);
  }
  :global(.theme-toggle) {
    grid-area: toggle;
  }
  @media (min-width: 52rem) {
    .bar {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'brand nav toggle';
      padding-block: 0.85rem;
    }
    nav {
      margin: 0;
      padding: 0;
      justify-self: end;
    }
  }
</style>
