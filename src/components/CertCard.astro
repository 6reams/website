---
import { badgeUrl, type Cert } from '@/lib/content';

interface Props {
  cert: Cert;
}
const { cert } = Astro.props;
const { name, abbr, issuer, credentialUrl, date } = cert.data;
const badge = badgeUrl(cert);
const Tag = credentialUrl ? 'a' : 'div';
const year = date?.getUTCFullYear();
---

<article class="cert-card">
  <Tag
    class="cert-inner"
    {...(credentialUrl
      ? { href: credentialUrl, rel: 'noopener', target: '_blank', 'aria-label': `Verify ${name} credential` }
      : {})}
  >
    <div class="cert-visual">
      {badge
        ? <img src={badge} alt={`${abbr} certification badge`} width="120" height="120" loading="lazy" decoding="async" />
        : <div class="cert-placeholder">
            <span class="cert-letter">{abbr}</span>
            <span class="cert-issuer-mark">{issuer}</span>
          </div>}
    </div>
    <div class="cert-details">
      <strong class="cert-name">{name}</strong>
      <span class="cert-meta">{issuer}{year ? ` · ${year}` : ''}</span>
    </div>
  </Tag>
</article>

<style>
  .cert-card {
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--bg-elev);
    overflow: hidden;
    transition: border-color 0.3s, transform 0.2s, box-shadow 0.3s;
  }
  .cert-card:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -6px rgba(0, 0, 0, 0.4);
  }
  .cert-inner {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }
  a.cert-inner:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: inherit;
  }
  .cert-visual {
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    background:
      radial-gradient(ellipse at 30% 30%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 60%),
      var(--bg-soft);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }
  .cert-visual img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 1.5rem;
  }
  .cert-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .cert-letter {
    font: 800 2rem/1 var(--font-display);
    color: var(--accent);
    letter-spacing: 0.04em;
    opacity: 0.8;
  }
  .cert-issuer-mark {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .cert-details {
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .cert-name {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .cert-meta {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
  }
</style>
