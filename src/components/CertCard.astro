---
import { badgeUrl, type Cert } from '@/lib/content';

interface Props {
  cert: Cert;
}
const { cert } = Astro.props;
const { name, abbr, issuer, credentialUrl } = cert.data;
const badge = badgeUrl(cert);
const Tag = credentialUrl ? 'a' : 'div';
---

<article class="cert-badge" data-animate>
  <Tag
    class="cert-inner"
    {...(credentialUrl
      ? { href: credentialUrl, rel: 'noopener', target: '_blank', 'aria-label': `Verify ${name} credential` }
      : {})}
  >
    <div class="badge-img">
      {badge
        ? <img src={badge} alt={`${abbr} certification badge`} width="96" height="96" loading="lazy" decoding="async" />
        : <span class="abbr-text">{abbr}</span>}
    </div>
    <strong class="cert-abbr">{abbr}</strong>
    <span class="cert-issuer">{issuer}</span>
    {credentialUrl && <span class="verify-hint" aria-hidden="true">Verify ↗</span>}
  </Tag>
</article>

<style>
  .cert-badge {
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-elev);
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .cert-badge:hover {
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    transform: translateY(-4px);
    box-shadow: 0 14px 36px -8px color-mix(in srgb, var(--accent) 20%, rgba(0,0,0,0.4));
  }
  .cert-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.6rem;
    padding: 1.5rem 1rem 1.25rem;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }
  a.cert-inner:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: inherit;
  }
  .badge-img {
    width: 5.5rem;
    height: 5.5rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background:
      radial-gradient(circle at 35% 30%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 65%),
      var(--bg-soft);
    border: 1px solid color-mix(in srgb, var(--accent) 20%, var(--border));
    overflow: hidden;
    transition: box-shadow 0.2s;
  }
  .cert-badge:hover .badge-img {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent);
  }
  .badge-img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 0.4rem;
  }
  .abbr-text {
    font: 700 0.85rem / 1 var(--font-mono);
    color: var(--accent);
    letter-spacing: 0.04em;
  }
  .cert-abbr {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--fg);
    letter-spacing: -0.01em;
  }
  .cert-issuer {
    font-size: 0.75rem;
    color: var(--muted);
    letter-spacing: 0.02em;
  }
  .verify-hint {
    font-size: 0.72rem;
    color: var(--accent);
    letter-spacing: 0.05em;
    opacity: 0;
    transform: translateY(3px);
    transition: opacity 0.2s, transform 0.2s;
    margin-top: 0.25rem;
  }
  .cert-badge:hover .verify-hint {
    opacity: 1;
    transform: translateY(0);
  }
</style>
