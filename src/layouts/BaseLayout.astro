---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import '../styles/shiki.generated.css';
import { site } from '@config';
import Seo, { type Props as SeoProps } from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props extends SeoProps {
  /** Optional page-specific <meta> CSP (used by /admin, which talks to Firebase). Production only. */
  metaCsp?: string;
}

const { metaCsp, ...seo } = Astro.props;
const accentCss = `:root{--accent-light:${site.accent.light};--accent-dark:${site.accent.dark}}`;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {metaCsp && import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={metaCsp} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0a10" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Applies the saved theme before first paint (no flash). Allowed by a CSP hash, not 'unsafe-inline'. -->
    <script is:inline>
      try{var t=localStorage.getItem('theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}
    </script>
    <style is:inline set:html={accentCss}></style>
    <Seo {...seo} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
