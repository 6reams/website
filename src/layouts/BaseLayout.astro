---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import '../styles/shiki.generated.css';
import { site } from '@config';
import Seo, { type Props as SeoProps } from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props extends SeoProps {
  /** Optional page-specific <meta> CSP (used by /admin, which talks to Firebase). Production only. */
  metaCsp?: string;
  /** Hide header + footer for minimal pages (e.g. homepage). */
  hideNav?: boolean;
}

const { metaCsp, hideNav, ...seo } = Astro.props;
const accentCss = `:root{--accent:${site.accent}}`;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {metaCsp && import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={metaCsp} />}
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0c1018" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <style is:inline set:html={accentCss}></style>
    <Seo {...seo} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {!hideNav && <Header />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!hideNav && <Footer />}
  </body>
</html>
