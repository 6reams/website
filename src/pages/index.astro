---
import { site } from '@config';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostItem from '../components/PostItem.astro';
import { getPosts, getProjects } from '@/lib/content';
import { stats } from '@/data/profile';
import { tools } from '@/tools/registry';

const projects = (await getProjects()).filter((p) => p.data.featured).slice(0, 3);
const posts = (await getPosts()).slice(0, 3);
---

<BaseLayout>
  <section class="hero section">
    <div class="hero-orb" aria-hidden="true"></div>
    <div class="container">
      <div class="hero-text">
        <div class="pill hero-pill">
          <span class="pill-dot" aria-hidden="true"></span>
          {site.location}
        </div>
        <h1 class="gradient-text">{site.intro}</h1>
        <p class="lede">{site.bio}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/projects/">View projects</a>
          <a class="btn" href="/contact/">Get in touch</a>
          <a class="btn" href={site.cv} download>Download CV</a>
        </div>
      </div>
    </div>

    <div class="container">
      <ul class="stats" aria-label="Highlights">
        {
          stats.map((s) => (
            <li>
              <span class="stat-val">{s.value}</span>
              <span class="label">{s.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" data-animate>
    <div class="container">
      <div class="section-head">
        <h2>Featured projects</h2>
        <a class="link-arrow" href="/projects/">All projects</a>
      </div>
      <div class="grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section class="section" data-animate>
    <div class="container prose-width">
      <div class="section-head">
        <h2>Latest writing</h2>
        <a class="link-arrow" href="/blog/">All posts</a>
      </div>
      {posts.map((post) => <PostItem post={post} />)}
    </div>
  </section>

  <section class="section" data-animate>
    <div class="container">
      <div class="section-head">
        <h2>Browser-based security tools</h2>
        <a class="link-arrow" href="/tools/">All tools</a>
      </div>
      <p class="muted tools-note">Everything runs locally in your browser. Nothing is ever sent to a server.</p>
      <ul class="tool-links">
        {
          tools.map((t) => (
            <li>
              <a href={`/tools/${t.slug}/`}>
                <span class="glyph mono" aria-hidden="true">{t.icon}</span>
                <span>
                  <strong>{t.name}</strong>
                  <span class="label">{t.tagline}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(3rem, 8vw, 5.5rem);
  }
  /* floating ambient orb — pure CSS, no JS */
  .hero-orb {
    position: absolute;
    top: -8rem;
    right: -12rem;
    width: clamp(22rem, 55vw, 48rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle at 40% 40%,
      color-mix(in srgb, var(--accent) 18%, transparent),
      transparent 65%
    );
    animation: float 12s ease-in-out infinite alternate;
    pointer-events: none;
  }
  .hero-text {
    position: relative;
    max-width: 44rem;
  }
  .hero-pill {
    margin-bottom: 1.5rem;
  }
  .hero h1 {
    max-width: 22ch;
    margin-bottom: 1rem;
  }
  .lede {
    color: var(--muted);
    font-size: 1.15rem;
    max-width: 38rem;
    margin-bottom: 1.75rem;
    line-height: 1.7;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    list-style: none;
    padding: 1.75rem 0 0;
    margin: 3.5rem 0 0;
    border-top: 1px solid var(--border);
  }
  .stats li {
    display: grid;
    gap: 0.3rem;
  }
  .stat-val {
    font: 700 clamp(1.6rem, 5vw, 2.5rem) / 1 var(--font-sans);
    color: var(--fg);
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, var(--fg), var(--accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .tools-note {
    margin-top: -0.75rem;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }
  .tool-links {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .tool-links a {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elev);
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .tool-links a:hover {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    transform: translateY(-3px);
    box-shadow: 0 12px 32px -8px color-mix(in srgb, var(--accent) 16%, rgba(0,0,0,0.3));
  }
  .tool-links strong {
    display: block;
    font-weight: 600;
  }
  .tool-links span span {
    display: block;
  }
  .glyph {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 700;
  }
</style>
