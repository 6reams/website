---
import { site } from '@config';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjects } from '@/lib/content';
import { getCerts } from '@/lib/content';

const projects = (await getProjects()).filter((p) => p.data.featured).slice(0, 4);
const certs = (await getCerts()).slice(0, 9);

const fmtDate = (d: Date) =>
  `${d.getUTCFullYear()}/${String(d.getUTCMonth() + 1).padStart(2, '0')}/${String(d.getUTCDate()).padStart(2, '0')}`;
---

<BaseLayout hideNav>
  <div class="home">

    <!-- Hero -->
    <section class="intro">
      <h1 class="name gradient-text">{site.name}</h1>
      <p class="role">{site.role}</p>

      <nav class="social" aria-label="Links">
        {site.socials.github && (
          <a href={site.socials.github} rel="me noopener" aria-label="GitHub">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          </a>
        )}
        {site.socials.linkedin && (
          <a href={site.socials.linkedin} rel="me noopener" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        )}
        {site.email && (
          <a href={`mailto:${site.email}`} aria-label="Email">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 7L2 7"/></svg>
          </a>
        )}
        <a href="/about/" class="all-links">All links &rarr;</a>
      </nav>

      <a class="cv-btn" href={site.cv} download>
        <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M10 3v10m0 0-3.5-3.5M10 13l3.5-3.5M3 17h14"/></svg>
        Download CV
      </a>
    </section>

    <!-- Projects -->
    <section class="projects">
      <div class="section-bar">
        <h2>Projects</h2>
        <a href="/projects/" class="section-link">All projects &rarr;</a>
      </div>

      {projects.map((project) => (
        <a class="project-row" href={`/projects/${project.id}/`}>
          <div class="project-thumb" aria-hidden="true">
            <div class="thumb-pattern"></div>
            <span class="thumb-label">{project.data.title.charAt(0)}</span>
          </div>
          <div class="project-info">
            <div class="project-top">
              <h3>{project.data.title}</h3>
              <time class="project-date" datetime={project.data.date.toISOString()}>
                {fmtDate(project.data.date)}
              </time>
            </div>
            <p>{project.data.description}</p>
          </div>
        </a>
      ))}
    </section>

    <!-- Certs strip -->
    <section class="certs-strip" aria-label="Certifications">
      <span class="certs-label">Certifications</span>
      <div class="certs-row">
        {certs.map((c) => (
          <span class="cert-badge" title={c.data.name}>{c.data.abbr}</span>
        ))}
      </div>
    </section>

    <!-- Minimal footer -->
    <footer class="home-footer">
      <p>&copy; {new Date().getFullYear()} {site.name}</p>
    </footer>

  </div>
</BaseLayout>

<style>
  .home {
    max-width: 52rem;
    margin: 0 auto;
    padding-inline: var(--gutter);
    padding-bottom: 2rem;
  }

  /* -------- intro -------- */
  .intro {
    padding-top: clamp(7rem, 20vw, 14rem);
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }
  .name {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 8vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin: 0 0 0.5em;
  }
  .role {
    color: var(--muted);
    font-size: 1.1rem;
    margin: 0 0 2rem;
    letter-spacing: 0.01em;
  }

  /* social icons row */
  .social {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
  }
  .social a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s, transform 0.2s;
    display: inline-flex;
  }
  .social a:hover {
    color: var(--fg);
    transform: translateY(-1px);
  }
  .all-links {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.02em;
  }

  /* CV download */
  .cv-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.15rem;
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    background: var(--bg-elev);
    color: var(--fg);
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .cv-btn:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, var(--bg-elev));
    color: var(--fg);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px -4px rgba(0, 0, 0, 0.3);
  }

  /* -------- projects -------- */
  .projects {
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .section-bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  .section-bar h2 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0;
  }
  .section-link {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .section-link:hover {
    color: var(--accent);
  }

  /* project row */
  .project-row {
    display: flex;
    gap: 1.25rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    transition: padding-left 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .project-row:last-of-type {
    border-bottom: 1px solid var(--border);
  }
  .project-row:hover {
    padding-left: 0.5rem;
  }
  .project-row:hover .project-thumb {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--border));
    box-shadow: 0 4px 16px -6px rgba(0, 0, 0, 0.4);
  }
  .project-row:hover .thumb-label {
    opacity: 1;
    color: var(--accent);
  }

  /* thumbnail */
  .project-thumb {
    flex-shrink: 0;
    width: 120px;
    height: 80px;
    border-radius: 10px;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    overflow: hidden;
    position: relative;
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .thumb-pattern {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle, color-mix(in srgb, var(--accent) 18%, transparent) 1px, transparent 1px);
    background-size: 10px 10px;
    background-position: 5px 5px;
    opacity: 0.7;
  }
  .thumb-label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--muted);
    opacity: 0.15;
    transition: opacity 0.3s, color 0.3s;
  }

  .project-row:nth-of-type(2n) .project-thumb {
    background: var(--bg-elev-2);
  }
  .project-row:nth-of-type(2n) .thumb-pattern {
    background-image:
      linear-gradient(45deg, color-mix(in srgb, var(--accent) 8%, transparent) 25%, transparent 25%),
      linear-gradient(-45deg, color-mix(in srgb, var(--accent) 8%, transparent) 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, color-mix(in srgb, var(--accent) 8%, transparent) 75%),
      linear-gradient(-45deg, transparent 75%, color-mix(in srgb, var(--accent) 8%, transparent) 75%);
    background-size: 12px 12px;
    background-position: 0 0, 0 6px, 6px -6px, -6px 0;
  }

  .project-info {
    flex: 1;
    min-width: 0;
  }
  .project-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.3rem;
  }
  .project-top h3 {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
    line-height: 1.3;
  }
  .project-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .project-info p {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0;
    line-height: 1.6;
  }

  /* -------- certs strip -------- */
  .certs-strip {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--border);
  }
  .certs-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .certs-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }
  .cert-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--muted);
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
    cursor: default;
  }
  .cert-badge:hover {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    background: color-mix(in srgb, var(--accent) 5%, transparent);
  }

  /* -------- home footer -------- */
  .home-footer {
    text-align: center;
    padding-top: 1rem;
  }
  .home-footer p {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
    opacity: 0.5;
    margin: 0;
  }

  /* -------- staggered entrance -------- */
  .intro > * {
    animation: reveal 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .intro > :nth-child(1) { animation-delay: 0ms; }
  .intro > :nth-child(2) { animation-delay: 80ms; }
  .intro > :nth-child(3) { animation-delay: 160ms; }
  .intro > :nth-child(4) { animation-delay: 240ms; }

  .projects {
    animation: reveal 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 350ms;
  }
  .certs-strip {
    animation: reveal 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 450ms;
  }
  .home-footer {
    animation: reveal 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 550ms;
  }

  /* -------- mobile -------- */
  @media (max-width: 36rem) {
    .project-thumb {
      width: 72px;
      height: 52px;
      border-radius: 8px;
    }
    .thumb-label {
      font-size: 1.3rem;
    }
    .project-top {
      flex-direction: column;
      gap: 0.1rem;
    }
    .project-row {
      gap: 1rem;
    }
  }
</style>
