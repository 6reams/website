---
import { site } from '@config';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostItem from '../components/PostItem.astro';
import { getPosts, getProjects } from '@/lib/content';
import { stats } from '@/data/profile';
import { tools } from '@/tools/registry';

const projects = (await getProjects()).filter((p) => p.data.featured).slice(0, 3);
const posts = (await getPosts()).slice(0, 3);
---

<BaseLayout>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container">
      <div class="hero-inner">
        <div>
          <div class="pill hero-pill">
            <span class="pill-dot" aria-hidden="true"></span>
            {site.location}
          </div>
        </div>
        <h1 class="gradient-text">{site.intro}</h1>
        <p class="hero-bio">{site.bio}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/projects/">View projects</a>
          <a class="btn" href="/contact/">Get in touch</a>
          <a class="btn" href={site.cv} download>Download CV</a>
        </div>
      </div>
    </div>

    <div class="container">
      <ul class="stats" aria-label="Highlights">
        {
          stats.map((s) => (
            <li>
              <span class="stat-val">{s.value}</span>
              <span class="stat-label">{s.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" data-animate>
    <div class="container">
      <div class="section-head">
        <h2>Featured projects</h2>
        <a class="link-arrow" href="/projects/">All projects</a>
      </div>
      <div class="grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section class="section" data-animate>
    <div class="container prose-width">
      <div class="section-head">
        <h2>Latest writing</h2>
        <a class="link-arrow" href="/blog/">All posts</a>
      </div>
      {posts.map((post) => <PostItem post={post} />)}
    </div>
  </section>

  <section class="section" data-animate>
    <div class="container">
      <div class="section-head">
        <h2>Browser-based security tools</h2>
        <a class="link-arrow" href="/tools/">All tools</a>
      </div>
      <p class="muted tools-note">Everything runs locally in your browser. Nothing is ever sent to a server.</p>
      <ul class="tool-links">
        {
          tools.map((t) => (
            <li>
              <a href={`/tools/${t.slug}/`}>
                <span class="glyph mono" aria-hidden="true">{t.icon}</span>
                <span>
                  <strong>{t.name}</strong>
                  <span class="tool-desc">{t.tagline}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(4rem, 10vw, 7rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse 70% 55% at 50% 0%, black 10%, transparent);
    -webkit-mask-image: radial-gradient(ellipse 70% 55% at 50% 0%, black 10%, transparent);
  }

  .hero-glow {
    position: absolute;
    top: -16rem;
    right: -8rem;
    width: clamp(24rem, 55vw, 50rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle at 40% 40%,
      color-mix(in srgb, var(--accent) 14%, transparent),
      transparent 60%
    );
    animation: float 14s ease-in-out infinite alternate;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    max-width: 42rem;
  }
  .hero-pill {
    margin-bottom: 1.75rem;
  }
  .hero h1 {
    max-width: 20ch;
    margin-bottom: 1.25rem;
  }
  .hero-bio {
    color: var(--muted);
    font-size: 1.1rem;
    max-width: 36rem;
    margin-bottom: 2rem;
    line-height: 1.75;
  }

  /* staggered entrance */
  .hero-inner > * {
    animation: reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .hero-inner > :nth-child(1) { animation-delay: 0ms; }
  .hero-inner > :nth-child(2) { animation-delay: 100ms; }
  .hero-inner > :nth-child(3) { animation-delay: 200ms; }
  .hero-inner > :nth-child(4) { animation-delay: 300ms; }
  .stats {
    animation: reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 400ms;
  }

  /* ---------- stats ---------- */
  .stats {
    display: flex;
    gap: 0;
    list-style: none;
    padding: 2rem 0 0;
    margin: 3.5rem 0 0;
    border-top: 1px solid var(--border);
  }
  .stats li {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-right: 1rem;
  }
  .stats li + li {
    padding-left: 1.5rem;
    border-left: 1px solid var(--border);
  }
  .stat-val {
    font: 700 clamp(1.5rem, 4.5vw, 2.25rem) / 1 var(--font-display);
    color: var(--fg);
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, var(--fg), var(--accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .stat-label {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ---------- tools ---------- */
  .tools-note {
    margin-top: -0.75rem;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }
  .tool-links {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .tool-links a {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elev);
    text-decoration: none;
    transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s;
  }
  .tool-links a:hover {
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    transform: translateY(-3px);
    box-shadow:
      0 12px 32px -8px rgba(0, 0, 0, 0.3),
      0 0 0 1px color-mix(in srgb, var(--accent) 10%, transparent);
  }
  .tool-links strong {
    display: block;
    font-weight: 600;
    font-family: var(--font-display);
  }
  .tool-links span span {
    display: block;
  }
  .tool-desc {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .glyph {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 700;
  }

  @media (max-width: 32rem) {
    .stats {
      flex-direction: column;
      gap: 1.25rem;
    }
    .stats li + li {
      padding-left: 0;
      padding-top: 1.25rem;
      border-left: none;
      border-top: 1px solid var(--border);
    }
  }
</style>
