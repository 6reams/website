---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Admin" description="Private content editor." noindex>
  <div class="container prose-width">
    <header class="page-head">
      <p class="eyebrow">Private</p>
      <h1>Content admin</h1>
      <p>Sign in to add a blog post or a certification. Entries are saved to Supabase; the live site picks them up on the next build.</p>
    </header>

    <div id="admin-unconfigured" class="callout" hidden>
      <strong>Supabase isn't configured.</strong> Set <code>PUBLIC_SUPABASE_URL</code> and <code>PUBLIC_SUPABASE_ANON_KEY</code> in your environment
      (see <code>.env.example</code>) and redeploy to use this page.
    </div>

    <!-- Sign in -->
    <section id="admin-login" class="section section-tight" hidden>
      <h2>Sign in</h2>
      <form id="login-form" autocomplete="on">
        <div class="field">
          <label for="login-email">Email</label>
          <input id="login-email" type="email" required autocomplete="username" />
        </div>
        <div class="field">
          <label for="login-password">Password</label>
          <input id="login-password" type="password" required autocomplete="current-password" />
        </div>
        <button class="btn btn-primary" type="submit">Sign in</button>
        <p id="login-error" class="status-bad mono" role="alert" hidden></p>
      </form>
    </section>

    <!-- Editor -->
    <section id="admin-app" class="section section-tight" hidden>
      <div class="who">
        <span class="label">Signed in as <span id="who-email" class="mono"></span></span>
        <button id="signout" class="btn btn-sm" type="button">Sign out</button>
      </div>

      <div class="tabs" role="tablist">
        <button class="tab is-active" type="button" data-tab="post" role="tab">New post</button>
        <button class="tab" type="button" data-tab="cert" role="tab">New certification</button>
      </div>

      <!-- Post form -->
      <form id="post-form" class="panel" data-pane="post">
        <div class="field">
          <label for="p-title">Title</label>
          <input id="p-title" type="text" required />
        </div>
        <div class="field">
          <label for="p-desc">Description</label>
          <input id="p-desc" type="text" required />
        </div>
        <div class="two">
          <div class="field">
            <label for="p-date">Date</label>
            <input id="p-date" type="date" required />
          </div>
          <div class="field">
            <label for="p-tags">Tags (comma-separated)</label>
            <input id="p-tags" type="text" placeholder="active-directory, web" />
          </div>
        </div>
        <div class="field">
          <label for="p-body">Body (Markdown)</label>
          <textarea id="p-body" required placeholder="## Heading&#10;&#10;Write in Markdown…"></textarea>
        </div>
        <label class="check"><input id="p-draft" type="checkbox" /> Save as draft (won't publish)</label>
        <div class="btn-row">
          <button class="btn btn-primary" type="submit">Save post</button>
        </div>
        <p class="status" data-status role="status" hidden></p>
      </form>

      <!-- Cert form -->
      <form id="cert-form" class="panel" data-pane="cert" hidden>
        <div class="two">
          <div class="field">
            <label for="c-abbr">Short code</label>
            <input id="c-abbr" type="text" required placeholder="CPTS" />
          </div>
          <div class="field">
            <label for="c-order">Order</label>
            <input id="c-order" type="number" value="10" />
          </div>
        </div>
        <div class="field">
          <label for="c-name">Full name</label>
          <input id="c-name" type="text" required placeholder="Certified Penetration Testing Specialist" />
        </div>
        <div class="two">
          <div class="field">
            <label for="c-issuer">Issuer</label>
            <input id="c-issuer" type="text" required placeholder="Hack The Box" />
          </div>
          <div class="field">
            <label for="c-date">Issue date</label>
            <input id="c-date" type="date" />
          </div>
        </div>
        <div class="field">
          <label for="c-url">Credential URL</label>
          <input id="c-url" type="url" placeholder="https://…" />
        </div>
        <div class="field">
          <label for="c-desc">Description (optional)</label>
          <textarea id="c-desc"></textarea>
        </div>
        <div class="field">
          <label for="c-badge">Badge image (optional — resized to a small WebP in your browser)</label>
          <input id="c-badge" type="file" accept="image/*" />
          <img id="c-preview" alt="Badge preview" width="72" height="72" hidden />
        </div>
        <div class="btn-row">
          <button class="btn btn-primary" type="submit">Save certification</button>
        </div>
        <p class="status" data-status role="status" hidden></p>
      </form>

      <section class="publish">
        <h2>Publish</h2>
        <p class="muted">Saved entries go live on the next build. If you set a deploy hook, trigger one now:</p>
        <button id="publish" class="btn" type="button" disabled>Trigger rebuild</button>
        <p id="publish-note" class="label"></p>
      </section>
    </section>
  </div>
</BaseLayout>

<script>
  import { isConfigured, supabase } from '@/lib/supabase';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const show = (el: HTMLElement | null, visible: boolean) => el && (el.hidden = !visible);

  const DEPLOY_HOOK: string = import.meta.env.PUBLIC_DEPLOY_HOOK ?? '';

  if (!isConfigured()) {
    show($('admin-unconfigured'), true);
  } else {
    const sb = supabase();

    // ---- auth state ----
    sb.auth.onAuthStateChange((_event, session) => {
      const user = session?.user ?? null;
      show($('admin-login'), !user);
      show($('admin-app'), !!user);
      if (user) $('who-email').textContent = user.email ?? '';
    });

    // check initial session
    const { data: { session: initial } } = await sb.auth.getSession();
    if (!initial) {
      show($('admin-login'), true);
    }

    let loginAttempts = 0;
    let lockoutUntil = 0;

    $('login-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const err = $('login-error');
      show(err, false);

      const now = Date.now();
      if (now < lockoutUntil) {
        show(err, true);
        err.textContent = `Too many attempts. Try again in ${Math.ceil((lockoutUntil - now) / 1000)}s.`;
        return;
      }

      const { error } = await sb.auth.signInWithPassword({
        email: ($('login-email') as HTMLInputElement).value,
        password: ($('login-password') as HTMLInputElement).value,
      });
      if (error) {
        loginAttempts++;
        if (loginAttempts >= 5) {
          lockoutUntil = now + loginAttempts * 5000;
        }
        show(err, true);
        err.textContent = 'Invalid email or password.';
      } else {
        loginAttempts = 0;
      }
    });

    $('signout').addEventListener('click', () => sb.auth.signOut());

    // ---- tabs ----
    document.querySelectorAll<HTMLButtonElement>('.tab').forEach((tab) =>
      tab.addEventListener('click', () => {
        document.querySelectorAll('.tab').forEach((t) => t.classList.toggle('is-active', t === tab));
        document.querySelectorAll<HTMLElement>('[data-pane]').forEach((p) => (p.hidden = p.dataset.pane !== tab.dataset.tab));
      }),
    );

    const setStatus = (form: HTMLElement, msg: string, ok: boolean) => {
      const el = form.querySelector<HTMLElement>('[data-status]')!;
      el.hidden = false;
      el.textContent = msg;
      el.className = `status ${ok ? 'status-ok' : 'status-bad'}`;
    };

    // ---- save post ----
    $('post-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.currentTarget as HTMLFormElement;
      try {
        const tags = ($('p-tags') as HTMLInputElement).value.split(',').map((t) => t.trim()).filter(Boolean);
        const { error } = await sb.from('posts').insert({
          title: ($('p-title') as HTMLInputElement).value,
          description: ($('p-desc') as HTMLInputElement).value,
          date: ($('p-date') as HTMLInputElement).value,
          tags,
          draft: ($('p-draft') as HTMLInputElement).checked,
          body: ($('p-body') as HTMLTextAreaElement).value,
        });
        if (error) throw error;
        form.reset();
        setStatus(form, 'Saved. It will appear after the next build.', true);
      } catch (ex) {
        setStatus(form, (ex as Error).message, false);
      }
    });

    // ---- badge resize ----
    let badgeData = '';
    $('c-badge').addEventListener('change', async (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      const preview = $('c-preview') as HTMLImageElement;
      if (!file) return;
      const bitmap = await createImageBitmap(file);
      const size = 144;
      const canvas = document.createElement('canvas');
      canvas.width = size;
      canvas.height = size;
      const ctx = canvas.getContext('2d')!;
      const scale = Math.min(size / bitmap.width, size / bitmap.height);
      const w = bitmap.width * scale;
      const h = bitmap.height * scale;
      ctx.drawImage(bitmap, (size - w) / 2, (size - h) / 2, w, h);
      badgeData = canvas.toDataURL('image/webp', 0.85);
      preview.src = badgeData;
      preview.hidden = false;
    });

    // ---- save cert ----
    $('cert-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.currentTarget as HTMLFormElement;
      try {
        const dateVal = ($('c-date') as HTMLInputElement).value;
        const { error } = await sb.from('certifications').insert({
          name: ($('c-name') as HTMLInputElement).value,
          abbr: ($('c-abbr') as HTMLInputElement).value,
          issuer: ($('c-issuer') as HTMLInputElement).value,
          date: dateVal || null,
          credential_url: ($('c-url') as HTMLInputElement).value || null,
          description: ($('c-desc') as HTMLTextAreaElement).value || null,
          order: Number(($('c-order') as HTMLInputElement).value) || 100,
          badge_data: badgeData || null,
        });
        if (error) throw error;
        form.reset();
        ($('c-preview') as HTMLImageElement).hidden = true;
        badgeData = '';
        setStatus(form, 'Saved. It will appear after the next build.', true);
      } catch (ex) {
        setStatus(form, (ex as Error).message, false);
      }
    });

    // ---- publish (optional deploy hook) ----
    const publishBtn = $('publish') as HTMLButtonElement;
    const note = $('publish-note');
    if (DEPLOY_HOOK) {
      publishBtn.disabled = false;
      publishBtn.addEventListener('click', async () => {
        publishBtn.disabled = true;
        try {
          await fetch(DEPLOY_HOOK, { method: 'POST' });
          note.textContent = 'Rebuild triggered. The site updates in a minute or two.';
        } catch (ex) {
          note.textContent = `Could not trigger rebuild: ${(ex as Error).message}`;
        } finally {
          publishBtn.disabled = false;
        }
      });
    } else {
      note.textContent = 'No deploy hook set (PUBLIC_DEPLOY_HOOK). Trigger a deploy from your dashboard, or push to your repo.';
    }
  }
</script>

<style>
  .who {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }
  .tab {
    padding: 0.5rem 1rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-elev);
    color: var(--muted);
    font: 500 0.9rem/1 var(--font-sans);
    cursor: pointer;
  }
  .tab.is-active {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-soft);
  }
  .panel {
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elev);
  }
  .two {
    display: grid;
    gap: 1rem;
  }
  #c-preview {
    margin-top: 0.75rem;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--bg-soft);
  }
  .publish {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .status {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  @media (min-width: 40rem) {
    .two {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
