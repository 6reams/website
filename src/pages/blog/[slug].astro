---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import TagList from '../../components/TagList.astro';
import { getPosts, formatDate, readingTime } from '@/lib/content';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, tags, date, updated } = post.data;
---

<BaseLayout title={title} description={description} type="article" tags={tags} publishedTime={date} modifiedTime={updated}>
  <div class="container inner-page">
    <Breadcrumb backHref="/blog/" backLabel="Back" />
    <article class="page-reveal">
      <header class="post-head">
        <h1>{title}</h1>
        <div class="post-meta">
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          <span class="sep" aria-hidden="true">&middot;</span>
          <span>{readingTime(post.body)}</span>
          {updated && <><span class="sep" aria-hidden="true">&middot;</span><span>updated {formatDate(updated)}</span></>}
        </div>
        <TagList tags={tags} linked />
      </header>
      <div class="prose">
        <Content />
      </div>
      <footer class="post-foot">
        <a class="back-link" href="/blog/">&larr; All posts</a>
      </footer>
    </article>
  </div>
</BaseLayout>

<style>
  .inner-page {
    max-width: 52rem;
    padding-bottom: 4rem;
  }
  .post-head {
    padding-top: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
  }
  .post-head h1 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 0.75rem;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
    letter-spacing: 0.02em;
    margin-bottom: 1rem;
  }
  .sep {
    opacity: 0.4;
  }
  .prose {
    max-width: var(--max-prose);
  }
  .post-foot {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .back-link {
    font-family: var(--font-display);
    font-size: 0.88rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .back-link:hover {
    color: var(--accent);
  }
</style>
