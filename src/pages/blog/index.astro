---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PostItem from '../../components/PostItem.astro';
import { getPosts, allTags } from '@/lib/content';

const posts = await getPosts();
const tags = allTags(posts);
---

<BaseLayout title="Blog" description="Notes on offensive security, Active Directory, web app testing and reporting.">
  <div class="container inner-page">
    <Breadcrumb />
    <header class="page-header">
      <h1>Blog</h1>
      <p>Notes on offensive security, Active Directory, web application testing and writing reports people act on.</p>
      {
        tags.length > 0 && (
          <ul class="tags mt-3" aria-label="Browse by tag">
            {tags.map((t) => (
              <li><a class="tag" href={`/blog/tags/${t.slug}/`}>{t.tag} &middot; {t.count}</a></li>
            ))}
          </ul>
        )
      }
    </header>
    <section class="post-list">
      {posts.length === 0 && <p class="muted">No posts yet.</p>}
      {posts.map((post) => <PostItem post={post} headingLevel="h2" />)}
    </section>
  </div>
</BaseLayout>

<style>
  .inner-page {
    max-width: 52rem;
    padding-bottom: 4rem;
  }
  .page-header {
    padding-top: 2rem;
    padding-bottom: 2rem;
  }
  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 0.5rem;
  }
  .page-header p {
    color: var(--muted);
    font-size: 1rem;
    margin: 0;
  }
</style>
