---
import BaseLayout from '../layouts/BaseLayout.astro';
import CertCard from '../components/CertCard.astro';
import { getCerts } from '@/lib/content';
import { site } from '@config';

const certs = await getCerts();
---

<BaseLayout
  title="Certifications"
  description={`${certs.length} offensive-security and application-security certifications held by ${site.name}.`}
>
  <div class="container">
    <header class="page-head">
      <div class="pill cert-count-pill">
        <span class="pill-dot" aria-hidden="true"></span>
        {certs.length} certifications
      </div>
      <h1>Credentials</h1>
      <p>Industry certifications across offensive security, red teaming and application security. Click any badge to verify the credential.</p>
    </header>
  </div>

  <section class="section section-tight">
    <div class="container">
      <div class="badge-grid">
        {certs.map((cert) => <CertCard cert={cert} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cert-count-pill {
    margin-bottom: 1.25rem;
  }
  .badge-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 9.5rem), 1fr));
    gap: 1rem;
  }
  @media (min-width: 48rem) {
    .badge-grid {
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr));
      gap: 1.25rem;
    }
  }
</style>
