---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CertCard from '../components/CertCard.astro';
import { getCerts } from '@/lib/content';
import { site } from '@config';

const certs = await getCerts();
---

<BaseLayout
  title="Certifications"
  description={`${certs.length} offensive-security and application-security certifications held by ${site.name}.`}
>
  <div class="container inner-page">
    <Breadcrumb />
    <header class="page-header page-reveal">
      <h1>Certifications</h1>
      <p>Verified credentials and professional specializations.</p>
    </header>

    <section class="cert-grid page-reveal page-reveal-d1">
      {certs.map((cert) => <CertCard cert={cert} />)}
    </section>
  </div>
</BaseLayout>

<style>
  .inner-page {
    max-width: 64rem;
    padding-bottom: 4rem;
  }
  .page-header {
    padding-top: 2rem;
    padding-bottom: 2rem;
  }
  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 0.5rem;
  }
  .page-header p {
    color: var(--muted);
    font-size: 1rem;
    margin: 0;
  }
  .cert-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  @media (max-width: 48rem) {
    .cert-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 30rem) {
    .cert-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
