---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { site } from '@config';

const channels = [
  site.email && { label: 'Email', value: site.email, href: `mailto:${site.email}`, glyph: '@' },
  site.socials.github && { label: 'GitHub', value: site.socials.github.replace('https://', ''), href: site.socials.github, glyph: 'gh' },
  site.socials.linkedin && { label: 'LinkedIn', value: site.socials.linkedin.replace('https://www.', ''), href: site.socials.linkedin, glyph: 'in' },
].filter(Boolean) as { label: string; value: string; href: string; glyph: string }[];
---

<BaseLayout title="Contact" description={`Get in touch with ${site.name}.`}>
  <div class="container inner-page prose-width">
    <Breadcrumb />
    <header class="page-header page-reveal">
      <h1>Contact</h1>
      <p>Open to penetration testing work, red team engagements and security training. The fastest way to reach me is email.</p>
    </header>

    <section class="contact-body page-reveal page-reveal-d1">
      <ul class="channels">
        {
          channels.map((c) => (
            <li>
              <a href={c.href} rel="me noopener" target={c.href.startsWith('mailto') ? undefined : '_blank'}>
                <span class="glyph mono" aria-hidden="true">{c.glyph}</span>
                <span class="meta">
                  <span class="ch-label">{c.label}</span>
                  <span class="val mono">{c.value}</span>
                </span>
                <span class="arrow" aria-hidden="true">&rarr;</span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="pgp">
        <h2>PGP</h2>
        {
          site.pgp.fingerprint ? (
            <>
              <p class="muted">For sensitive reports or disclosures, encrypt to my public key.</p>
              <dl class="kv">
                <dt>Fingerprint</dt>
                <dd>{site.pgp.fingerprint}</dd>
              </dl>
              <a class="cv-btn" href={site.pgp.keyUrl} download>Download public key</a>
            </>
          ) : (
            <p class="muted">
              A PGP key isn't published yet. Add your fingerprint and key file in
              <code>site.config.ts</code> and <code>public/pgp.asc</code> to show this section.
            </p>
          )
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .inner-page {
    padding-bottom: 4rem;
  }
  .page-header {
    padding-top: 2rem;
    padding-bottom: 2rem;
  }
  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 0.5rem;
  }
  .page-header p {
    color: var(--muted);
    font-size: 1rem;
    margin: 0;
  }

  .channels {
    list-style: none;
    padding: 0;
    margin: 0 0 2.5rem;
    display: grid;
    gap: 0.75rem;
  }
  .channels a {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-elev);
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
  }
  .channels a:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
    transform: translateX(4px);
  }
  .glyph {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 8px;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 700;
    font-size: 0.85rem;
  }
  .meta {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }
  .ch-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .val {
    font-size: 0.9rem;
    overflow-wrap: anywhere;
  }
  .arrow {
    margin-left: auto;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .pgp {
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-soft);
  }
  .pgp h2 {
    font-size: 1.15rem;
    margin-top: 0;
  }
  .cv-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--bg-elev);
    color: var(--fg);
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .cv-btn:hover {
    border-color: var(--accent);
    color: var(--fg);
  }
</style>
