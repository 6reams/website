---
---

<section class="tool" data-tool="encoder">
  <div class="controls">
    <div class="field">
      <label for="enc-scheme">Scheme</label>
      <select id="enc-scheme">
        <option value="base64">Base64</option>
        <option value="base64url">Base64 URL-safe</option>
        <option value="url">URL (percent-encoding)</option>
        <option value="html">HTML entities</option>
        <option value="hex">Hex</option>
      </select>
    </div>
    <div class="field">
      <span class="field-label">Direction</span>
      <div class="seg" role="radiogroup" aria-label="Direction">
        <label class="check"><input type="radio" name="enc-dir" value="encode" checked /> Encode</label>
        <label class="check"><input type="radio" name="enc-dir" value="decode" /> Decode</label>
      </div>
    </div>
  </div>

  <div class="field">
    <label for="enc-input">Input</label>
    <textarea id="enc-input" placeholder="Type or paste…" autocomplete="off" spellcheck="false"></textarea>
  </div>

  <div class="field">
    <div class="out-head">
      <span class="field-label">Output</span>
      <button id="enc-copy" class="btn btn-sm" type="button">Copy</button>
    </div>
    <output id="enc-output" class="output"></output>
  </div>
  <p id="enc-error" class="status-bad mono" role="alert" hidden></p>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-tool="encoder"]')!;
  const scheme = root.querySelector<HTMLSelectElement>('#enc-scheme')!;
  const input = root.querySelector<HTMLTextAreaElement>('#enc-input')!;
  const output = root.querySelector<HTMLOutputElement>('#enc-output')!;
  const errorEl = root.querySelector<HTMLElement>('#enc-error')!;
  const dir = () => root.querySelector<HTMLInputElement>('input[name="enc-dir"]:checked')!.value;

  const enc = new TextEncoder();
  const dec = new TextDecoder('utf-8', { fatal: true });
  const toBytes = (s: string) => enc.encode(s);
  const bytesToB64 = (b: Uint8Array) => btoa(String.fromCharCode(...b));
  const b64ToBytes = (s: string) => Uint8Array.from(atob(s), (c) => c.charCodeAt(0));

  const HTML_MAP: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };

  const transforms: Record<string, { encode: (s: string) => string; decode: (s: string) => string }> = {
    base64: {
      encode: (s) => bytesToB64(toBytes(s)),
      decode: (s) => dec.decode(b64ToBytes(s.trim())),
    },
    base64url: {
      encode: (s) => bytesToB64(toBytes(s)).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, ''),
      decode: (s) => {
        let t = s.trim().replace(/-/g, '+').replace(/_/g, '/');
        while (t.length % 4) t += '=';
        return dec.decode(b64ToBytes(t));
      },
    },
    url: {
      encode: (s) => encodeURIComponent(s),
      decode: (s) => decodeURIComponent(s.trim()),
    },
    html: {
      encode: (s) => s.replace(/[&<>"']/g, (c) => HTML_MAP[c]),
      decode: (s) => {
        const el = document.createElement('textarea');
        el.innerHTML = s;
        return el.value;
      },
    },
    hex: {
      encode: (s) => [...toBytes(s)].map((b) => b.toString(16).padStart(2, '0')).join(''),
      decode: (s) => {
        const clean = s.trim().replace(/0x/gi, '').replace(/[\s:,-]/g, '');
        if (clean.length % 2 || /[^0-9a-f]/i.test(clean)) throw new Error('Not valid hex');
        return dec.decode(Uint8Array.from(clean.match(/.{2}/g)!.map((h) => parseInt(h, 16))));
      },
    },
  };

  function run() {
    errorEl.hidden = true;
    const value = input.value;
    if (!value) {
      output.textContent = '';
      return;
    }
    try {
      output.textContent = transforms[scheme.value][dir() as 'encode' | 'decode'](value);
    } catch (e) {
      output.textContent = '';
      errorEl.hidden = false;
      errorEl.textContent = `Could not ${dir()}: ${(e as Error).message}`;
    }
  }

  root.addEventListener('input', run);
  root.querySelectorAll('input[name="enc-dir"]').forEach((r) => r.addEventListener('change', run));

  root.querySelector('#enc-copy')!.addEventListener('click', async () => {
    const value = output.textContent ?? '';
    if (!value) return;
    try {
      await navigator.clipboard.writeText(value);
    } catch {
      /* clipboard blocked */
    }
  });
</script>

<style>
  .controls {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  .seg {
    display: flex;
    gap: 1.25rem;
    min-height: 2.75rem;
    align-items: center;
  }
  .out-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  @media (min-width: 40rem) {
    .controls {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
