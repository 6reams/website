---
---

<section class="tool" data-tool="password">
  <div class="panel">
    <div class="label label-accent">Generate</div>
    <div class="gen-out">
      <output id="pw-generated" class="output mono"></output>
      <div class="btn-row">
        <button id="pw-regen" class="btn btn-sm" type="button" aria-label="Regenerate">↻</button>
        <button id="pw-copy" class="btn btn-sm" type="button">Copy</button>
      </div>
    </div>

    <div class="field">
      <label for="pw-length">Length: <span id="pw-length-val" class="mono">20</span></label>
      <input id="pw-length" type="range" min="8" max="64" value="20" />
    </div>
    <div class="opts">
      <label class="check"><input type="checkbox" id="pw-upper" checked /> A–Z</label>
      <label class="check"><input type="checkbox" id="pw-lower" checked /> a–z</label>
      <label class="check"><input type="checkbox" id="pw-digits" checked /> 0–9</label>
      <label class="check"><input type="checkbox" id="pw-symbols" checked /> Symbols</label>
      <label class="check"><input type="checkbox" id="pw-ambiguous" /> Avoid look-alikes</label>
    </div>
  </div>

  <div class="panel">
    <div class="label label-accent">Strength checker</div>
    <div class="field">
      <label for="pw-check">Test a password</label>
      <input id="pw-check" type="text" autocomplete="off" spellcheck="false" placeholder="Type to analyse…" />
      <label class="check small"><input type="checkbox" id="pw-reveal" checked /> Show characters</label>
    </div>
    <div class="meter" aria-hidden="true"><span id="pw-bar"></span></div>
    <p id="pw-verdict" class="verdict" role="status">Waiting for input…</p>
    <dl class="kv">
      <dt>Entropy</dt><dd id="pw-entropy">—</dd>
      <dt>Length</dt><dd id="pw-count">0</dd>
      <dt>Crack time</dt><dd id="pw-crack">—</dd>
    </dl>
    <p class="label note">Offline estimate only — entropy from character set and length. Never reuse a real password here.</p>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-tool="password"]')!;
  const $ = <T extends HTMLElement>(id: string) => root.querySelector<T>(id)!;

  // ---- generator ----
  const SETS = {
    upper: 'ABCDEFGHJKLMNPQRSTUVWXYZ',
    lower: 'abcdefghijkmnopqrstuvwxyz',
    digits: '23456789',
    symbols: '!@#$%^&*()-_=+[]{};:,.?/',
  };
  const AMBIGUOUS = { upper: 'IO', lower: 'l', digits: '01', symbols: '' };
  const gen = $<HTMLOutputElement>('#pw-generated');
  const lengthEl = $<HTMLInputElement>('#pw-length');
  const lengthVal = $('#pw-length-val');

  function pool(): string {
    const avoid = ($('#pw-ambiguous') as HTMLInputElement).checked;
    let chars = '';
    for (const key of ['upper', 'lower', 'digits', 'symbols'] as const) {
      if (($(`#pw-${key}`) as HTMLInputElement).checked) {
        chars += avoid ? SETS[key] : SETS[key] + AMBIGUOUS[key];
      }
    }
    return chars;
  }

  function generate() {
    const chars = pool();
    const len = Number(lengthEl.value);
    lengthVal.textContent = String(len);
    if (!chars) {
      gen.textContent = 'Select at least one character set';
      return;
    }
    const rnd = new Uint32Array(len);
    crypto.getRandomValues(rnd);
    // Rejection sampling to avoid modulo bias.
    const limit = Math.floor(0xffffffff / chars.length) * chars.length;
    let result = '';
    let i = 0;
    while (result.length < len) {
      if (i >= rnd.length) {
        crypto.getRandomValues(rnd);
        i = 0;
      }
      const v = rnd[i++];
      if (v < limit) result += chars[v % chars.length];
    }
    gen.textContent = result;
  }

  root.querySelectorAll('.opts input, #pw-length').forEach((el) => el.addEventListener('input', generate));
  $('#pw-regen').addEventListener('click', generate);
  $('#pw-copy').addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(gen.textContent ?? '');
    } catch {
      /* clipboard blocked */
    }
  });

  // ---- strength checker ----
  const check = $<HTMLInputElement>('#pw-check');
  const bar = $('#pw-bar');
  const verdict = $('#pw-verdict');

  function charsetSize(pw: string): number {
    let size = 0;
    if (/[a-z]/.test(pw)) size += 26;
    if (/[A-Z]/.test(pw)) size += 26;
    if (/[0-9]/.test(pw)) size += 10;
    if (/[^a-zA-Z0-9]/.test(pw)) size += 33;
    return size;
  }

  function humanTime(seconds: number): string {
    if (seconds < 1) return 'instant';
    const units: [number, string][] = [
      [60, 'second'],
      [60, 'minute'],
      [24, 'hour'],
      [365, 'day'],
      [100, 'year'],
    ];
    let value = seconds;
    let name = 'second';
    for (const [factor, label] of units) {
      if (value < factor) {
        name = label;
        break;
      }
      value /= factor;
      name = label;
    }
    if (name === 'year' && value > 1e6) return 'centuries';
    const n = value < 10 ? value.toFixed(1) : Math.round(value).toLocaleString();
    return `${n} ${name}${Number(n) === 1 ? '' : 's'}`;
  }

  function analyse() {
    const pw = check.value;
    $('#pw-count').textContent = String(pw.length);
    if (!pw) {
      bar.style.width = '0%';
      bar.dataset.level = '';
      verdict.textContent = 'Waiting for input…';
      verdict.className = 'verdict';
      $('#pw-entropy').textContent = '—';
      $('#pw-crack').textContent = '—';
      return;
    }
    const entropy = pw.length * Math.log2(charsetSize(pw) || 1);
    // 1e10 guesses/sec offline, average half the keyspace.
    const seconds = (2 ** entropy / 1e10) / 2;
    $('#pw-entropy').textContent = `${entropy.toFixed(1)} bits`;
    $('#pw-crack').textContent = humanTime(seconds);

    const levels = [
      { max: 35, label: 'Very weak', cls: 'status-bad', pct: 20 },
      { max: 59, label: 'Weak', cls: 'status-bad', pct: 40 },
      { max: 79, label: 'Reasonable', cls: 'status-warn', pct: 65 },
      { max: 109, label: 'Strong', cls: 'status-ok', pct: 85 },
      { max: Infinity, label: 'Very strong', cls: 'status-ok', pct: 100 },
    ];
    const level = levels.find((l) => entropy < l.max)!;
    bar.style.width = `${level.pct}%`;
    bar.dataset.level = level.cls;
    verdict.textContent = level.label;
    verdict.className = `verdict ${level.cls}`;
  }

  check.addEventListener('input', analyse);
  $('#pw-reveal').addEventListener('change', (e) => {
    check.type = (e.target as HTMLInputElement).checked ? 'text' : 'password';
  });

  generate();
</script>

<style>
  .tool {
    display: grid;
    gap: 1.5rem;
  }
  .panel {
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elev);
  }
  .panel > .label:first-child {
    display: block;
    margin-bottom: 1rem;
  }
  .gen-out {
    display: flex;
    gap: 0.75rem;
    align-items: stretch;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }
  .gen-out output {
    flex: 1;
    min-width: 12rem;
    font-size: 1.05rem;
    display: flex;
    align-items: center;
  }
  .opts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
  .small {
    font-size: 0.8rem;
    margin-top: 0.5rem;
  }
  .meter {
    height: 0.5rem;
    border-radius: 999px;
    background: var(--bg-soft);
    overflow: hidden;
    border: 1px solid var(--border);
    margin: 0.5rem 0 0.75rem;
  }
  .meter span {
    display: block;
    height: 100%;
    width: 0;
    border-radius: 999px;
    background: var(--bad);
    transition: width 0.2s ease;
  }
  .meter span[data-level='status-warn'] {
    background: var(--warn);
  }
  .meter span[data-level='status-ok'] {
    background: var(--ok);
  }
  .verdict {
    font-weight: 600;
    margin: 0 0 1rem;
  }
  .note {
    margin: 0.75rem 0 0;
  }
  @media (min-width: 46rem) {
    .tool {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
