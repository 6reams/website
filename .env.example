# Supabase config (Supabase dashboard → Settings → API).
# These values are NOT secrets — the anon key is designed to be public.
# Security comes from Row Level Security policies, not from hiding these.
# Leave them empty to build from local Markdown only.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Optional: a Cloudflare Pages / Netlify "deploy hook" URL. If set, the /admin page shows a
# "Trigger rebuild" button that POSTs here to rebuild and publish. Safe to be public.
PUBLIC_DEPLOY_HOOK=
