# Firebase web config (Firebase console → Project settings → Your apps → Web app).
# These values are NOT secrets — Firebase web config is designed to be public.
# Security comes from firestore.rules, not from hiding these.
# Leave them empty to build from local Markdown only.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=

# Optional: a Cloudflare Pages / Netlify "deploy hook" URL. If set, the /admin page shows a
# "Trigger rebuild" button that POSTs here to rebuild and publish. Safe to be public.
PUBLIC_DEPLOY_HOOK=
